<Window x:Class="EnvMaid.App.Views.TextListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="List" Width="360" Height="520"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}">
    <DockPanel Margin="20">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top"
                   Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>
        <Button DockPanel.Dock="Bottom" Content="Close" Click="Close_Click"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Style="{StaticResource SecondaryButton}"/>
        <TextBox x:Name="Body" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                 FontFamily="Cascadia Mono" FontSize="12" Padding="10"/>
    </DockPanel>
</Window>
