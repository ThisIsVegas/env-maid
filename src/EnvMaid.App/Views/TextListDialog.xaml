<Window x:Class="EnvMaid.App.Views.TextListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="List" Width="360" Height="520"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E" FontFamily="Segoe UI">
    <DockPanel Margin="16">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Foreground="#CDD6F4"
                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <Button DockPanel.Dock="Bottom" Content="Close" Click="Close_Click" Width="90" Height="32"
                HorizontalAlignment="Right" Margin="0,12,0,0"
                Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand"/>
        <TextBox x:Name="Body" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" Background="#181825" Foreground="#CDD6F4"
                 BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="8"/>
    </DockPanel>
</Window>
