<Window x:Class="EnvMaid.App.Views.PathInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Path"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

        <TextBox x:Name="InputBox" Grid.Row="1" Height="36" Padding="9,7" FontSize="13"
                 FontFamily="Cascadia Mono"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click"
                    Style="{StaticResource GhostButton}"/>
            <Button Content="Save path" Click="Ok_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
