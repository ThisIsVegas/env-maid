<Window x:Class="EnvMaid.App.Views.SaveDiffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review changes before saving" SizeToContent="Height" Width="640"
        MaxHeight="700" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E2E" FontFamily="Segoe UI">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Review changes before saving" Foreground="#CDD6F4"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" Text="A backup is created automatically before anything is written."
                   Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,14"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Width="110" Height="34" Margin="0,0,8,0"
                    Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Confirm &amp; Save" Click="Confirm_Click" Width="130" Height="34"
                    Background="#89B4FA" Foreground="#1E1E2E" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ScopeList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="{Binding ScopeTitle}" Foreground="#CDD6F4"
                                           FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="🛡 requires elevation" Foreground="#FAB387" FontSize="12"
                                           Margin="10,2,0,0"
                                           Visibility="{Binding RequiresElevationVisibility}"/>
                            </StackPanel>

                            <TextBlock Text="No changes." Foreground="#6C7086" FontSize="12"
                                       Visibility="{Binding NoChangesVisibility}"/>

                            <TextBlock Text="⚠ Entry order changed" Foreground="#FAB387" FontSize="12"
                                       Margin="0,0,0,4" Visibility="{Binding OrderChangedVisibility}"/>

                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                                   FontFamily="Consolas" FontSize="12" Margin="0,1,0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
