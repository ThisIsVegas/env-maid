<Window x:Class="EnvMaid.App.Views.SaveDiffDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review changes"
        Width="760"
        MaxHeight="760"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Review changes" Style="{StaticResource PageTitle}" FontSize="23"/>
            <TextBlock x:Name="SummaryText"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="13"
                       Margin="0,6,0,0"/>
            <TextBlock Text="A backup will be created before anything is written to Windows."
                       Style="{StaticResource MutedText}"
                       Margin="0,4,0,0"/>
            <!-- Stated before the write, where it can still inform the decision. Deliberately
                 does not claim the change is applied everywhere, and does not say running apps
                 pick it up without a reboot — they keep the old environment permanently. -->
            <TextBlock Text="After saving, newly launched programs will use the new PATH. Programs already running — terminals, editors, and services — keep the old one until they are restarted."
                       Style="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Click="Cancel_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="ConfirmButton"
                    Style="{StaticResource PrimaryButton}"
                    Click="Confirm_Click"/>
        </StackPanel>

        <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ScopeList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,22">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ScopeTitle}" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding ElevationText}"
                                               Foreground="{StaticResource AttentionBrush}"
                                               FontSize="12"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding RequiresElevationVisibility}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ChangeCountLabel}"
                                           Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Border BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,1,0,0"
                                    Visibility="{Binding OrderChangedVisibility}">
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="REORDER" Foreground="{StaticResource AttentionBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Entry order changed" FontWeight="SemiBold"/>
                                        <TextBlock Text="This can change which copy of a command Windows runs."
                                                   Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Changes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="0,1,0,0"
                                                Margin="0,12,0,0"
                                                Padding="0,12,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="88"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding KindLabel}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding KindLabel}" Value="ADD">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding KindLabel}" Value="REMOVE">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding KindLabel}" Value="MOVE">
                                                                    <Setter Property="Foreground" Value="{StaticResource AttentionBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding KindLabel}" Value="CHANGE">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Path}"
                                                               FontFamily="Cascadia Mono"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Reason}"
                                                               Style="{StaticResource MutedText}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander Header="Technical diff" Margin="0,14,0,0">
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12"
                                        Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding TechnicalLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Cascadia Mono"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Expander>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
