<Window x:Class="EnvMaid.App.Views.MaintenancePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review maintenance changes"
        Width="720"
        MaxHeight="720"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitle}" FontSize="22"/>
            <TextBlock x:Name="SummaryText"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0"/>
            <TextBlock x:Name="ScopeText"
                       Style="{StaticResource EyebrowText}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Click="Cancel_Click"
                    Margin="0,0,8,0"/>
            <Button x:Name="ConfirmButton"
                    Style="{StaticResource PrimaryButton}"
                    Click="Confirm_Click"/>
        </StackPanel>

        <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChangeList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Top"
                                          Margin="0,3,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource EyebrowText}" Margin="0,2,12,0"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Before}"
                                               FontFamily="Cascadia Mono"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Margin="0,6,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding After}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="BECOMES" Style="{StaticResource EyebrowText}"/>
                                        <TextBlock Text="{Binding After}"
                                                   FontFamily="Cascadia Mono"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Explanation}"
                                               Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
