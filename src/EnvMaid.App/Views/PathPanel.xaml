<UserControl x:Class="EnvMaid.App.Views.PathPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EnvMaid.App.Converters"
             xmlns:beh="clr-namespace:EnvMaid.App.Behaviors">

    <UserControl.Resources>
        <conv:ConfidenceToBrushConverter x:Key="ConfidenceToBrush"/>
        <conv:LengthToWidthConverter x:Key="LengthToWidth"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:PathExistsConverter x:Key="PathExists"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility"/>
        <conv:ConflictConfidenceConverter x:Key="ConflictConfidence"/>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowDetailsVisibilityMode" Value="Collapsed"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#181825"/>
        </Style>

        <Style TargetType="DataGridRow">
            <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick"/>
            <Setter Property="Background" Value="{Binding Confidence, Converter={StaticResource ConfidenceToBrush}}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLengthLimitBoundary}" Value="False">
                    <Setter Property="DetailsVisibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLengthLimitBoundary}" Value="True">
                    <Setter Property="DetailsVisibility" Value="Visible"/>
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="0,10,0,0">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding LengthLabel}" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
            <Border Height="6" Background="#313244" CornerRadius="3" HorizontalAlignment="Stretch">
                <Border Height="6" HorizontalAlignment="Left" CornerRadius="3"
                        Width="{Binding TotalLength, Converter={StaticResource LengthToWidth}}"
                        Background="{Binding BarColor}" Margin="0"/>
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Add" Style="{StaticResource SmallButton}" Command="{Binding AddCommand}"/>
            <Button Content="Edit" Style="{StaticResource SmallButton}" Command="{Binding EditCommand}"/>
            <Button Content="Remove" Style="{StaticResource SmallButton}" Command="{Binding RemoveCommand}"/>
            <Button Content="Move Up" Style="{StaticResource SmallButton}" Command="{Binding MoveUpCommand}"/>
            <Button Content="Move Down" Style="{StaticResource SmallButton}" Command="{Binding MoveDownCommand}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                  beh:DataGridDragDropReorder.IsEnabled="True">
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <StackPanel Margin="34,6,4,6">
                        <Border Background="#3A2C22" CornerRadius="3" Padding="8,6"
                                Visibility="{Binding IsLengthLimitBoundary, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Foreground="#FAB387" FontSize="12" TextWrapping="Wrap">
                                <Run Text="⚠ 2047-character PATH limit reached here." FontWeight="SemiBold"/>
                                <LineBreak/>
                                <Run Text="Entries below may not load in some tools/applications." Foreground="#CDD6F4"/>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Rank" Binding="{Binding GlobalRank}" Width="50" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#6C7086"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="✓" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Conflict" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center">
                                <Border Width="10" Height="10" CornerRadius="5"
                                        ToolTip="Shadow conflict — see the Conflicts tab"
                                        Visibility="{Binding HasShadowConflicts, Converter={StaticResource BoolToVisibility}}"
                                        Background="{Binding ShadowConfidence, Converter={StaticResource ConflictConfidence}, ConverterParameter=brush}"/>
                                <TextBlock Text="—" Foreground="#45475A" FontSize="12" HorizontalAlignment="Center"
                                           Visibility="{Binding HasShadowConflicts, Converter={StaticResource InverseBoolToVisibility}}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Path" Width="530">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CDD6F4"/>
                                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPastLengthLimit}" Value="True">
                                                <Setter Property="Foreground" Value="#5C6270"/>
                                                <Setter Property="ToolTip" Value="Past the 2047-character PATH limit — may not load in some tools/applications."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="270" IsReadOnly="True"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit"
                              Command="{Binding PlacementTarget.DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Remove"
                              Command="{Binding PlacementTarget.DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Move Up"
                              Command="{Binding PlacementTarget.DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Move Down"
                              Command="{Binding PlacementTarget.DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="Open in Explorer"
                              Command="{Binding PlacementTarget.DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource PathExists}}"/>
                    <MenuItem Header="Copy Path"
                              Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</UserControl>
