<UserControl x:Class="EnvMaid.App.Views.PathPanel"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EnvMaid.App.Converters"
             xmlns:beh="clr-namespace:EnvMaid.App.Behaviors">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:PathExistsConverter x:Key="PathExists"/>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowDetailsVisibilityMode" Value="Collapsed"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="RowHeight" Value="46"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <EventSetter Event="MouseDoubleClick" Handler="Row_MouseDoubleClick"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#181C22"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#202A38"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="Add location"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Select multiple"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleBulkSelectionCommand}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding LengthLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LengthOverLimit}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AttentionBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button x:Name="ToolsButton"
                        Content="Maintenance"
                        Style="{StaticResource SecondaryButton}"
                        Click="ToolsButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Background="{StaticResource ElevatedBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource DividerBrush}">
                            <MenuItem Header="Normalize paths"
                                      ToolTip="Preview canonical path formatting changes"
                                      Command="{Binding PlacementTarget.DataContext.NormalizeCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Remove duplicates"
                                      ToolTip="Preview repeated locations; the first is kept"
                                      Command="{Binding PlacementTarget.DataContext.RemoveDuplicatesCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Remove missing locations"
                                      ToolTip="Preview missing or empty PATH entries"
                                      Command="{Binding PlacementTarget.DataContext.RemoveBrokenCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Separator/>
                            <MenuItem Header="Compress paths"
                                      ToolTip="Preview shorter values using environment variables"
                                      Command="{Binding PlacementTarget.DataContext.CompressCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Style="{StaticResource SurfaceBorder}"
                Padding="12,9"
                Margin="0,0,0,10"
                Visibility="{Binding IsBulkSelectionMode, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Select the locations you want to change."
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Remove selected from PATH"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding RemoveCheckedCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="Cancel"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ToggleBulkSelectionCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <DataGrid ItemsSource="{Binding Entries}"
                      SelectedItem="{Binding SelectedEntry}"
                      beh:DataGridDragDropReorder.IsEnabled="True"
                      Margin="0,0,18,0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="36">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding DataContext.IsBulkSelectionMode,
                                                               RelativeSource={RelativeSource AncestorType=DataGrid},
                                                               Converter={StaticResource BoolToVis}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="PRIORITY" Binding="{Binding GlobalRank}" Width="72" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="LOCATION" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path}"
                                           FontFamily="Cascadia Mono"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="STATUS" Width="138">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusLabel}"
                                           Foreground="{StaticResource AttentionBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu Background="{StaticResource ElevatedBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource DividerBrush}">
                        <MenuItem Header="Edit path"
                                  Command="{Binding PlacementTarget.DataContext.EditCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Move earlier"
                                  Command="{Binding PlacementTarget.DataContext.MoveUpCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <MenuItem Header="Move later"
                                  Command="{Binding PlacementTarget.DataContext.MoveDownCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Remove from PATH"
                                  Command="{Binding PlacementTarget.DataContext.RemoveCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        <Separator/>
                        <MenuItem Header="Open in Explorer"
                                  Command="{Binding PlacementTarget.DataContext.OpenInExplorerCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  IsEnabled="{Binding PlacementTarget.SelectedItem.Path,
                                                      RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                      Converter={StaticResource PathExists}}"/>
                        <MenuItem Header="Copy path"
                                  Command="{Binding PlacementTarget.DataContext.CopyPathCommand,
                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem,
                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

            <Border Grid.Column="1"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1,0,0,0"
                    Padding="22,4,0,0">
                <Grid>
                    <TextBlock Text="Select a location to see its details and available actions."
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ContentControl Content="{Binding SelectedEntry}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusLabel}"
                                               Foreground="{StaticResource AttentionBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Path}"
                                               FontFamily="Cascadia Mono"
                                               FontSize="15"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Reason}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0"/>

                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="SCOPE" Style="{StaticResource EyebrowText}" Margin="0,0,0,10"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Scope}" Margin="0,0,0,10"/>
                                        <TextBlock Grid.Row="1" Text="ORDER" Style="{StaticResource EyebrowText}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GlobalRank}"/>
                                    </Grid>

                                    <WrapPanel Margin="0,22,0,0">
                                        <Button Content="Edit path"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.EditCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="Move earlier"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.MoveUpCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="Move later"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.MoveDownCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="0,0,8,8"/>
                                        <Button Content="Remove from PATH"
                                                Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.RemoveCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
