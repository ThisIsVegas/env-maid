<UserControl x:Class="EnvMaid.App.Views.PathPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EnvMaid.App.Converters"
             xmlns:beh="clr-namespace:EnvMaid.App.Behaviors">

    <UserControl.Resources>
        <conv:ConfidenceToBrushConverter x:Key="ConfidenceToBrush"/>
        <conv:LengthToWidthConverter x:Key="LengthToWidth"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:PathExistsConverter x:Key="PathExists"/>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowDetailsVisibilityMode" Value="Collapsed"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#181825"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{Binding Confidence, Converter={StaticResource ConfidenceToBrush}}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="DetailsVisibility" Value="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="0,10,0,0">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding LengthLabel}" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
            <Border Height="6" Background="#313244" CornerRadius="3" HorizontalAlignment="Stretch">
                <Border Height="6" HorizontalAlignment="Left" CornerRadius="3"
                        Width="{Binding TotalLength, Converter={StaticResource LengthToWidth}}"
                        Background="{Binding BarColor}" Margin="0"/>
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Add" Style="{StaticResource SmallButton}" Command="{Binding AddCommand}"/>
            <Button Content="Edit" Style="{StaticResource SmallButton}" Command="{Binding EditCommand}"/>
            <Button Content="Remove" Style="{StaticResource SmallButton}" Command="{Binding RemoveCommand}"/>
            <Button Content="Move Up" Style="{StaticResource SmallButton}" Command="{Binding MoveUpCommand}"/>
            <Button Content="Move Down" Style="{StaticResource SmallButton}" Command="{Binding MoveDownCommand}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                  beh:DataGridDragDropReorder.IsEnabled="True">
            <DataGrid.Resources>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <ItemsControl ItemsSource="{Binding ShadowConflicts}" Margin="34,4,4,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#11181825" Padding="6,3" Margin="0,0,0,2"
                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open shadowing folder in Explorer"
                                                      Command="{Binding PlacementTarget.Tag.OpenShadowFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Copy exe name"
                                                      Command="{Binding PlacementTarget.Tag.CopyExeNameCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <MenuItem Header="Copy winning folder path"
                                                      Command="{Binding PlacementTarget.Tag.CopyShadowedFolderPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding PlacementTarget.DataContext.ExeName, RelativeSource={RelativeSource AncestorType=ContextMenu}, StringFormat='Search: multiple {0} versions'}"
                                                      Command="{Binding PlacementTarget.Tag.SearchMultipleVersionsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <TextBlock Foreground="#CDD6F4" FontSize="12">
                                        <Run Text="{Binding ExeName, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text=" — shadowed by "/>
                                        <Run Text="{Binding ShadowedFolderPath, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                            <Setter Property="DetailsVisibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✓" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked}" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="⚠" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ToggleButton IsChecked="{Binding IsExpanded}"
                                          Visibility="{Binding HasShadowConflicts, Converter={StaticResource BoolToVisibility}}"
                                          Content="{Binding ShadowConflicts.Count, StringFormat='⚠ {0}'}"
                                          Background="Transparent" BorderThickness="0" Foreground="#FAB387" Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="580" IsReadOnly="True"/>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="270" IsReadOnly="True"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit"
                              Command="{Binding PlacementTarget.DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Remove"
                              Command="{Binding PlacementTarget.DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Move Up"
                              Command="{Binding PlacementTarget.DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <MenuItem Header="Move Down"
                              Command="{Binding PlacementTarget.DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                    <Separator/>
                    <MenuItem Header="Open in Explorer"
                              Command="{Binding PlacementTarget.DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              IsEnabled="{Binding PlacementTarget.SelectedItem.Path, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource PathExists}}"/>
                    <MenuItem Header="Copy Path"
                              Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</UserControl>
