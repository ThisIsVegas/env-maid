<UserControl x:Class="EnvMaid.App.Views.ConflictsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EnvMaid.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <conv:ConflictConfidenceConverter x:Key="Confidence"/>
    </UserControl.Resources>

    <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Command priority" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Windows uses the first available copy of each command."
                           Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="ConflictToolsButton"
                    Grid.Column="1"
                    Content="Tool list"
                    Style="{StaticResource SecondaryButton}"
                    Click="ConflictToolsButton_Click">
                <Button.ContextMenu>
                    <ContextMenu Background="{StaticResource ElevatedBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="{StaticResource DividerBrush}">
                        <MenuItem Header="Edit my CLI tool list…" Click="OpenToolsFile_Click"/>
                        <MenuItem Header="Reload tool list" Click="ReloadTools_Click"/>
                        <Separator/>
                        <MenuItem Header="View built-in list…" Click="ViewBuiltIn_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasConflicts, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="No command-priority concerns detected."
                       Style="{StaticResource SectionTitle}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Each command resolves to a single location."
                       Style="{StaticResource MutedText}"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="1" Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox ItemsSource="{Binding Groups}"
                     SelectedItem="{Binding SelectedGroup}"
                     Background="Transparent"
                     BorderBrush="{StaticResource DividerBrush}"
                     BorderThickness="0,1,1,0"
                     Foreground="{StaticResource TextBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#202A38"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ExeName}"
                                       FontFamily="Cascadia Mono"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Losers.Count, StringFormat={}{0} other}"
                                       Style="{StaticResource MutedText}"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          Margin="24,0,0,0">
                <StackPanel DataContext="{Binding SelectedGroup}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ExeName}"
                                   Style="{StaticResource PageTitle}"
                                   FontFamily="Cascadia Mono"
                                   FontSize="23"/>
                        <Border Background="{StaticResource ElevatedBrush}"
                                CornerRadius="10"
                                Padding="9,3"
                                Margin="12,3,0,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="{Binding Confidence, Converter={StaticResource Confidence}}"
                                       Style="{StaticResource MutedText}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Resolution order"
                               Style="{StaticResource EyebrowText}"
                               Margin="0,22,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="1"
                                Background="{StaticResource DividerBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0"/>
                        <Ellipse Grid.Column="0"
                                 Width="12"
                                 Height="12"
                                 Fill="{StaticResource AccentBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="0,5,0,0"/>
                        <StackPanel Grid.Column="1" Margin="4,0,0,22">
                            <TextBlock Text="Currently used" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Winner.DisplayPath}"
                                       FontFamily="Cascadia Mono"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding Winner.Scope, StringFormat={}Scope: {0}}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding DataContext.SelectedLosers,
                                                       RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="1"
                                            Background="{StaticResource DividerBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Height="28"/>
                                    <Ellipse Grid.Column="0"
                                             Width="10"
                                             Height="10"
                                             Fill="{StaticResource CanvasBrush}"
                                             Stroke="{StaticResource MutedTextBrush}"
                                             StrokeThickness="2"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Top"
                                             Margin="0,5,0,0"/>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,24">
                                        <TextBlock Text="Other available copy" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DisplayPath}"
                                                   FontFamily="Cascadia Mono"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding Scope, StringFormat={}Scope: {0}}"
                                                   Style="{StaticResource MutedText}"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="System PATH is searched before User PATH, so reordering cannot change this result."
                                                   Foreground="{StaticResource AttentionBrush}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,8,0,0"
                                                   Visibility="{Binding IsCrossScope, Converter={StaticResource BoolToVis}}"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Content="Use this version"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Visibility="{Binding CanReorder, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.UseVersionCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"/>
                                            <Button Content="Remove from PATH"
                                                    Style="{StaticResource DangerButton}"
                                                    Command="{Binding DataContext.DeleteLoserCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,8,8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
