<UserControl x:Class="EnvMaid.App.Views.ConflictsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EnvMaid.App.Converters">
    <UserControl.Resources>
        <conv:ConflictConfidenceConverter x:Key="Confidence"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- No-conflicts message -->
        <TextBlock Grid.ColumnSpan="2" Text="No conflicts detected." Foreground="#A6E3A1"
                   FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasConflicts, Converter={StaticResource InverseBoolToVis}}"/>

        <!-- Master: group list -->
        <ListBox Grid.Column="0" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                 Background="#181825" BorderThickness="0" Foreground="#CDD6F4"
                 Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Background="{Binding Confidence, Converter={StaticResource Confidence}, ConverterParameter=brush}"/>
                        <TextBlock Text="{Binding ExeName}" Foreground="#CDD6F4" FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Losers.Count, StringFormat=' ({0})'}"
                                   Foreground="#6C7086" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Detail: selected group -->
        <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasConflicts, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                            DataContext="{Binding SelectedGroup}">
                    <TextBlock Text="{Binding ExeName}" Foreground="#CDD6F4" FontSize="20" FontWeight="Bold"/>
                    <Border CornerRadius="10" Padding="8,3" Margin="12,2,0,0" VerticalAlignment="Center"
                            Background="{Binding Confidence, Converter={StaticResource Confidence}, ConverterParameter=brush}">
                        <TextBlock Text="{Binding Confidence, Converter={StaticResource Confidence}}"
                                   Foreground="#1E1E2E" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Winner -->
                <TextBlock Text="Winner (this copy runs):" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="#1E3A2E" CornerRadius="4" Padding="10,8" Margin="0,0,0,14"
                        DataContext="{Binding SelectedGroup}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Foreground="#A6E3A1" FontSize="13" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Winner.DisplayPath}" Foreground="#CDD6F4" FontSize="13"/>
                        <TextBlock Text="{Binding Winner.Scope, StringFormat='  [{0}]'}" Foreground="#6C7086" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Losers -->
                <TextBlock Text="Shadowed copies (do not run):" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding SelectedLosers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#181825" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayPath}" Foreground="#CDD6F4" FontSize="13"/>
                                        <TextBlock Text="{Binding Scope, StringFormat='  [{0}]'}" Foreground="#6C7086" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Cross-scope advisory -->
                                    <TextBlock Foreground="#FAB387" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Visibility="{Binding IsCrossScope, Converter={StaticResource BoolToVis}}"
                                               Text="System PATH always resolves before User PATH — reordering can't fix this. Delete the losing copy to resolve."/>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Pick winner (reorder)" Style="{StaticResource ActionButton}"
                                                Visibility="{Binding CanReorder, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.PickWinnerOverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Delete this folder" Style="{StaticResource ActionButton}"
                                                Command="{Binding DataContext.DeleteLoserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
