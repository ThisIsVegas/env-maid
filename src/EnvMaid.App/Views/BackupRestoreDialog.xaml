<Window x:Class="EnvMaid.App.Views.BackupRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore Backup"
        Width="420" Height="420"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Restore a backup" Style="{StaticResource PageTitle}" FontSize="22"/>
            <TextBlock Text="Choose a previously saved PATH state." Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
        </StackPanel>

        <ListBox x:Name="BackupList" Grid.Row="1"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                 MouseDoubleClick="BackupList_MouseDoubleClick"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click"
                    Style="{StaticResource GhostButton}"/>
            <Button Content="Restore backup" Click="Restore_Click" IsDefault="True"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
