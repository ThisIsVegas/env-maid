<Window x:Class="EnvMaid.App.Views.BackupRestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore Backup"
        Width="420" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select a backup to restore:" Foreground="#CDD6F4" FontSize="14" Margin="0,0,0,10"/>

        <ListBox x:Name="BackupList" Grid.Row="1" Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                 MouseDoubleClick="BackupList_MouseDoubleClick"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0" Click="Cancel_Click"
                    Background="#45475A" Foreground="#CDD6F4" BorderThickness="0"/>
            <Button Content="Restore" Width="80" Height="30" Click="Restore_Click" IsDefault="True"
                    Background="#F38BA8" Foreground="#1E1E2E" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
