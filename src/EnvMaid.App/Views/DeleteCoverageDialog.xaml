<Window x:Class="EnvMaid.App.Views.DeleteCoverageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remove from PATH?"
        Width="620"
        MaxHeight="700"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindow}">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Remove this location from PATH?"
                       Style="{StaticResource PageTitle}"
                       FontSize="22"/>
            <TextBlock x:Name="FolderText"
                       FontFamily="Cascadia Mono"
                       Foreground="{StaticResource AccentBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
            <TextBlock Text="No files or folders will be deleted."
                       Style="{StaticResource MutedText}"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Click="Cancel_Click"
                    Margin="0,0,8,0"/>
            <Button Content="Remove from PATH"
                    Style="{StaticResource DangerButton}"
                    Click="Delete_Click"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Command impact" Style="{StaticResource SectionTitle}" FontSize="15"/>
            <TextBlock Text="Review which commands remain available after this change."
                       Style="{StaticResource MutedText}" Margin="0,4,0,10"/>

            <ItemsControl x:Name="CoverageList" MaxHeight="360">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ExeName}"
                                           FontFamily="Cascadia Mono"
                                           FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CoveredBy, StringFormat={}Still available from {0}}"
                                           Foreground="{StaticResource SuccessBrush}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCovered}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1"
                                           Text="Will no longer be available through PATH"
                                           Foreground="{StaticResource DangerBrush}"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCovered}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DockPanel>
</Window>
