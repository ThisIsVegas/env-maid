<Window x:Class="EnvMaid.App.Views.DeleteCoverageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete folder from PATH?" SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1E1E2E" FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock Text="Delete this folder from PATH?" Foreground="#CDD6F4"
                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock x:Name="FolderText" Foreground="#89B4FA" FontSize="13"
                   TextWrapping="Wrap" Margin="0,0,0,12"/>

        <TextBlock Text="This folder provides these commands:" Foreground="#A6ADC8"
                   FontSize="12" Margin="0,0,0,6"/>

        <ItemsControl x:Name="CoverageList" MaxHeight="280">
            <ItemsControl.Template>
                <ControlTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#181825" CornerRadius="3" Padding="8,5" Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ExeName}" Foreground="#CDD6F4"
                                       FontWeight="SemiBold" FontSize="12" Width="150"/>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCovered}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="✓ still covered by " Foreground="#A6E3A1" FontSize="12"/>
                                <TextBlock Text="{Binding CoveredBy}" Foreground="#A6ADC8" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="✗ not on PATH anywhere else — you lose this command"
                                       Foreground="#F38BA8" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCovered}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Width="90" Height="32" Margin="0,0,8,0"
                    Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Delete" Click="Delete_Click" Width="90" Height="32"
                    Background="#F38BA8" Foreground="#1E1E2E" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
