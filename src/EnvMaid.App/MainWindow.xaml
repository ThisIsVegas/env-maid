<Window x:Class="EnvMaid.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:EnvMaid.App.Views"
        xmlns:conv="clr-namespace:EnvMaid.App.Converters"
        Title="EnvMaid"
        Width="1180"
        Height="820"
        MinWidth="920"
        MinHeight="650"
        Icon="Assets/app_icon.ico"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

        <Style x:Key="IssueRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,14"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="24,18,24,20">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/app_icon.ico"
                       Width="30"
                       Height="30"
                       Stretch="Uniform"
                       Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="EnvMaid" FontFamily="Segoe UI Variable Display"
                               FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding LastScannedLabel}" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Scan again" Style="{StaticResource GhostButton}"
                        Command="{Binding RescanCommand}" Margin="0,0,6,0"/>
                <Button x:Name="MoreButton" Content="More" Style="{StaticResource SecondaryButton}"
                        Click="MoreButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Background="{StaticResource ElevatedBrush}"
                                     Foreground="{StaticResource TextBrush}"
                                     BorderBrush="{StaticResource DividerBrush}">
                            <MenuItem Header="Restore backup…" Click="RestoreBackup_Click"/>
                            <Separator/>
                            <MenuItem Header="Import PATH profile…"
                                      Command="{Binding PlacementTarget.DataContext.ImportCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <MenuItem Header="Export PATH profile…"
                                      Command="{Binding PlacementTarget.DataContext.ExportCommand,
                                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource MutedText}"
                   Margin="40,0,0,4"/>

        <Border DockPanel.Dock="Bottom"
                Style="{StaticResource SurfaceBorder}"
                Padding="16,12"
                Margin="0,14,0,0"
                Visibility="{Binding HasStagedChanges, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="You have unsaved changes" FontWeight="SemiBold"/>
                    <TextBlock Text="Review the exact changes before anything is written to Windows."
                               Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Review and save"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Style="{StaticResource QuietTabControl}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource NavTab}"/>
            </TabControl.ItemContainerStyle>

            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,34,0,0" DataContext="{Binding Dashboard}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,48,0">
                            <Border Width="34" Height="4" Background="{StaticResource AccentBrush}"
                                    CornerRadius="2" HorizontalAlignment="Left" Margin="0,0,0,18"/>
                            <TextBlock Text="{Binding HealthTitle}" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="{Binding HealthSummary}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <Button Content="Review items"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,22,0,0"
                                    Click="ReviewItems_Click"
                                    Visibility="{Binding HasAttention, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="No action is needed."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,20,0,0"
                                       Visibility="{Binding HasAttention, Converter={StaticResource InverseBoolToVis}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Needs attention" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource IssueRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BrokenCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Missing locations" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding BrokenCount, StringFormat={}{0} entries can be safely reviewed}"
                                                   Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Review" Style="{StaticResource GhostButton}"
                                            Click="ReviewBroken_Click"/>
                                </Grid>
                            </Border>

                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource IssueRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DuplicateCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Duplicate entries" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding DuplicateCount, StringFormat={}{0} repeated locations detected}"
                                                   Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Review" Style="{StaticResource GhostButton}"
                                            Click="ReviewDuplicates_Click"/>
                                </Grid>
                            </Border>

                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource IssueRow}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConflictCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Command priority" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ConflictCount, StringFormat={}{0} commands have other available copies}"
                                                   Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Review" Style="{StaticResource GhostButton}"
                                            Click="ReviewConflicts_Click"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Nothing needs attention."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding HasAttention, Converter={StaticResource InverseBoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="PATH editor">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="PATH editor" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="View, reorder, and edit every location. Windows searches System PATH before User PATH."
                                   Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <TabControl x:Name="EditorTabs" Grid.Row="1" Style="{StaticResource QuietTabControl}" Margin="0,12,0,0">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem" BasedOn="{StaticResource NavTab}"/>
                        </TabControl.ItemContainerStyle>
                        <TabItem Header="User">
                            <views:PathPanel x:Name="UserPanel"
                                             DataContext="{Binding UserPaths}"
                                             ConflictActivated="PathPanel_ConflictActivated"/>
                        </TabItem>
                        <TabItem Header="System · administrator approval on save">
                            <views:PathPanel x:Name="SystemPanel"
                                             DataContext="{Binding SystemPaths}"
                                             ConflictActivated="PathPanel_ConflictActivated"/>
                        </TabItem>
                        <TabItem Header="Command priority">
                            <views:ConflictsView DataContext="{Binding Conflicts}"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
